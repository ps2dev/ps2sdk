EE_BIN = mouse.elf
EE_OBJS = mouse.o
EE_LIBS = -lmouse -lpatches -ldebug -ldraw -lgraph -lmath3d -lpacket -ldma

IRX_FILES += usbd.irx ps2mouse.irx
EE_OBJS += $(IRX_FILES:.irx=_irx.o)

all: cursor.c $(EE_BIN)

cursor.c: cursor.raw
	bin2c cursor.raw cursor.c cursor

clean:
	rm -f $(EE_BIN) $(EE_OBJS) cursor.c *_irx.c

%_irx.c:
	bin2c $(PS2SDK)/iop/irx/$*.irx $@ $*_irx

run: $(EE_BIN)
	ps2client execee host:$(EE_BIN)

reset:
	ps2client reset

include $(PS2SDK)/samples/Makefile.pref
include $(PS2SDK)/samples/Makefile.eeglobal
